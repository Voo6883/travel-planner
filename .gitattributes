# Line-ending normalisation.
#
# Without this, a shell script authored on Windows is checked out with CRLF on
# Linux and dies with `bad interpreter: /usr/bin/env bash^M`. The prerequisite
# gate must run identically on both platforms (Task 01 DoD), so the endings are
# pinned per file type rather than left to core.autocrlf.

* text=auto

*.sh    text eol=lf
*.mjs   text eol=lf
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
