{
  "name": "travel-planner",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root - orchestration scripts only. Application code lives in apps/frontend and apps/backend.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "prereq": "node scripts/prereq.mjs",
    "prereq:test": "node scripts/tests/run-prereq-tests.mjs",
    "codegen": "npm --prefix apps/frontend run codegen",
    "verify:fast": "node scripts/verify.mjs fast",
    "verify:task": "node scripts/verify.mjs task",
    "verify:full": "node scripts/verify.mjs full",
    "task:context": "node scripts/task-context.mjs",
    "task:report": "node scripts/task-report.mjs",
    "code-map": "node scripts/code-map.mjs",
    "code-map:check": "node scripts/code-map.mjs --check",
    "docs:stale": "node scripts/stale-docs.mjs",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d --remove-orphans",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "dev": "npm run dev:apps",
    "dev:apps": "node scripts/dev-apps.mjs",
    "dev:backend": "node scripts/dev-backend.mjs",
    "dev:frontend": "node scripts/dev-frontend.mjs",
    "dev:full": "npm run dev:db && npm run dev:apps",
    "wait": "node scripts/wait.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}
