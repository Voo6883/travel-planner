# Environment — single root .env (§4.0.0.2)
.env
.env.local
apps/frontend/.env.local

# Dependencies & build
node_modules/
apps/frontend/.next/
apps/backend/build/
apps/backend/.gradle/
*.tsbuildinfo

# Serwist service worker — build output of `next build` from apps/frontend/src/sw.ts, written
# into public/ so Next serves it from the origin root (PLAN §4.2.11: "do not hand-edit").
# Committing it would let a stale worker outlive the bundle it was generated for.
apps/frontend/public/sw.js
apps/frontend/public/sw.js.map

# next-env.d.ts is deliberately NOT ignored: it is committed so `npm ci && npm run typecheck`
# succeeds without first running a build, which is the order CI uses (tasks/05).

# Secrets
secrets/
*.pem

# IDE & OS
.idea/
.vscode/
.DS_Store

# Agent worktrees — each is a full checkout of the repo living inside it. Without this,
# `git add -A` during a parallel run stages a second copy of the entire tree.
.claude/worktrees/

# Quality-gate reports (task 15). Regenerated by every `./gradlew build` and
# `npm run test:coverage`; committing them would produce diff noise on every run and, worse,
# let a stale report be mistaken for current evidence.
apps/frontend/coverage/

# `npm run task:report -- NN` output. Deliberately ignored: it is evidence attached to a PR or
# pasted into the ledger, and a committed copy is a report that outlives the run that produced it —
# which is exactly the stale-evidence problem the command exists to remove.
artifacts/
