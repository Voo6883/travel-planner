<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Travel Planner — backend Checkstyle ruleset (tasks/15-quality-gates.md).

  Scope is deliberately narrow: line length, naming, and import hygiene. These are the rules the
  plan actually locks (PLAN §4.0.9 and §13; AI-AGENT-WORKFLOW.md "Line length ≤120"), and they
  are mechanical — a violation is never a judgement call, so the gate can be trusted.

  What is NOT here, on purpose: MethodLength, FileLength, ParameterNumber, CyclomaticComplexity.
  Task 15 states "Do not enforce subjective method/file size heuristics through brittle
  transformations". Those limits live in the AI-AGENT-WORKFLOW.md review checklist, where a human
  can weigh them, rather than in a gate that would be worked around by extracting nonsense helpers.

  Every module is severity=error. A warning-level rule in a build with maxWarnings=0 fails anyway,
  but says "warning" while doing it, which is worse than saying nothing.
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="charset" value="UTF-8"/>
  <property name="fileExtensions" value="java"/>

  <!-- PLAN §1067: max 120 characters, soft target 100. Package and import statements are exempt
       because they are not wrappable: a deep package name cannot be "fixed" by the author. -->
  <module name="LineLength">
    <property name="max" value="120"/>
    <property name="ignorePattern" value="^package .*|^import .*|^\s*//\s*https?://\S+$"/>
  </module>

  <!-- Tabs render at a different width in every editor, so a tab-indented file silently breaks the
       120-column rule for the next reader. -->
  <module name="FileTabCharacter"/>

  <!-- Narrow, individually justified exceptions. `config_loc` is supplied by the Gradle plugin and
       resolves to this directory. -->
  <module name="SuppressionFilter">
    <property name="file" value="${config_loc}/suppressions.xml"/>
  </module>

  <module name="TreeWalker">

    <!--
      Naming (PLAN §13). Defaults from Sun/Google conventions, stated explicitly so the ruleset
      documents the project's expectation rather than inheriting it invisibly.
    -->
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="MemberName"/>
    <module name="ParameterName"/>
    <module name="LocalVariableName"/>
    <module name="LocalFinalVariableName"/>
    <!-- `log` is permitted alongside SCREAMING_SNAKE_CASE. `private static final Logger log` is the
         SLF4J idiom, it is what Lombok's @Slf4j generates, and the codebase already uses it in 35
         classes. Renaming all of them to LOG would be churn in service of the gate rather than the
         other way round. Every other constant still has to shout. -->
    <module name="ConstantName">
      <property name="format" value="^log$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
    </module>
    <module name="StaticVariableName"/>

    <!--
      Import hygiene.

      AvoidStarImport matters beyond tidiness here: `import com.travelplanner.domain.*` would make
      the ArchUnit layer rules harder to read at review time, and a star import silently absorbs
      new types added to the package later.
    -->
    <module name="AvoidStarImport"/>
    <module name="UnusedImports">
      <!-- Javadoc {@link} counts as a use; without this, removing a "dead" import breaks docs. -->
      <property name="processJavadoc" value="true"/>
    </module>
    <module name="RedundantImport"/>
    <module name="IllegalImport"/>

    <!--
      Correctness rules that are mechanical enough to gate on.
    -->
    <!-- `if (x) doThing();` silently excludes the next line from the branch when someone adds
         one. This is the classic goto-fail shape. -->
    <module name="NeedBraces"/>
    <!-- An empty `catch {}` discards a failure with no record. Requires a named-intent variable. -->
    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="expected|ignored"/>
    </module>
    <module name="EqualsAvoidNull"/>
    <module name="StringLiteralEquality"/>
    <module name="FallThrough"/>
    <module name="MissingOverride"/>
    <module name="DefaultComesLast"/>
    <module name="OneStatementPerLine"/>
    <module name="UpperEll"/>
    <module name="ModifierOrder"/>

  </module>
</module>
