# Travel Planner — environment template
# Copy to .env and fill in values. Never commit .env

# --- Database ---
POSTGRES_DB=travel_planner
POSTGRES_USER=travel_planner
POSTGRES_PASSWORD=change_me
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/travel_planner

# --- JWT session (ADR 002) ---
JWT_SECRET=change_me_min_32_chars_random_string

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Firebase (Google / Gmail login — ADR 004) ---
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# --- GitHub OAuth (ADR 004) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/oauth/github/callback

# --- Resend mailer (§4.0.10) ---
RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com
MAILER_PROVIDER=stub
# MAILER_PROVIDER=resend

# --- Frontend (public — safe in NEXT_PUBLIC_*) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# --- App URLs ---
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
