# Travel Planner — single environment file (§4.0.0.2)
# Copy to .env at REPO ROOT and fill in values. Never commit .env
#
# This ONE file configures: Docker Compose, backend, and frontend.
# Do NOT create apps/frontend/.env.local or duplicate keys elsewhere.

# --- Host port bindings (Docker Compose) ---
# CONTAINER ports are fixed by the plan (backend 8080, frontend 3000, postgres 5432).
# These override only the HOST side, for machines where a port is already taken.
# Defaults match §4.0.0 exactly — change them in your local .env, never here.
# Example: Oracle XE's APEX endpoint also listens on 8080.
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
POSTGRES_HOST_PORT=5432

# --- Database ---
POSTGRES_DB=travel_planner
POSTGRES_USER=travel_planner
POSTGRES_PASSWORD=change_me
# Docker Compose default (hostname = service name "postgres"):
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/travel_planner
# Host-run backend against Compose Postgres only:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/travel_planner
DB_POOL_SIZE=10

# --- JWT session (ADR 002) ---
JWT_SECRET=change_me_min_32_chars_random_string

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER_DEFAULT=anthropic

# --- Firebase (Gmail sign-up & login — ADR 004) ---
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# --- GitHub OAuth (ADR 004) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/oauth/github/callback

# --- Resend mailer (§4.0.10) ---
RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com
MAILER_PROVIDER=stub
# MAILER_PROVIDER=resend

# --- Frontend (NEXT_PUBLIC_* — exposed to browser) ---
# ADR 006: the browser only ever talks to the FRONTEND origin. This is a RELATIVE path, and
# Next.js `rewrites()` proxies /api/v1/** to Spring Boot. Do not make it absolute: the session
# cookie is httpOnly + SameSite=Lax, so a cross-origin base URL silently drops it and every
# authenticated request fails. It no longer tracks BACKEND_HOST_PORT — nothing browser-side does.
# NEXT_PUBLIC_* is inlined at BUILD time, so a change needs `docker compose build frontend`.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Where the Next.js SERVER reaches the backend (ADR 006). Server-only — never NEXT_PUBLIC_*,
# because the browser must not learn a second, cookie-less way to reach the API. It is the
# rewrite target and the base for any server-side render that calls the API.
#   Docker Compose : http://backend:8080   (service name — resolvable only inside the network)
#   Frontend on the host : http://localhost:${BACKEND_HOST_PORT}
BACKEND_INTERNAL_URL=http://backend:8080
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# --- App URLs & CORS ---
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Optional (Phase 2+) ---
# REDIS_URL=redis://redis:6379
